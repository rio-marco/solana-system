<%- include("header") %>

    <h2>Account Recovery Request</h2>
    <p>Hi <strong><%= userName %></strong>,</p>
    <p>We received a recovery request for your Solana System account. Click the button below to securely log into your account:</p>

    <a href="<%= directLoginUrl %>" class="btn-login">Login to My Account</a>

    <p style="margin-top: 24px; color: #888; font-size: 13px;">
        This link is valid for <strong><%= expireIn %> minutes</strong> and can only be used once.
    </p>

    <p class="footer">
        If you did not request account recovery, please ignore this email.<br>
        Your account remains secure.
    </p>

<%- include("footer") %>
