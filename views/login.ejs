<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Login - Solana SOL Deposit &amp; Withdrawal System</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body class="auth-body d-flex align-items-center justify-content-center py-5 min-vh-100">

        <div class="auth-card p-4 p-md-5 rounded-4">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center mb-2 px-3 py-1 rounded-pill bg-dark border border-secondary">
                    <span class="text-warning fw-bold me-2"><i class="fa-solid fa-coins"></i></span>
                    <span class="fs-7 fw-600 text-light">Solana Platform</span>
                </div>
                <h2 class="h4 fw-700 text-white mt-2">Welcome Back</h2>
                <p class="text-white fs-7">Sign in to manage your SOL deposits and withdrawals</p>
            </div>

            <% if (body.errorMessage) { %>
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <%= body.errorMessage %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <form id="loginForm" novalidate>
                <div class="mb-3">
                    <label for="email" class="form-label text-light fs-7 fw-600">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                        <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
                    </div>
                </div>

                <button type="button" id="btnLoginSubmit" class="btn btn-solana w-100 py-2 rounded-3 fs-6 mb-2">
                    <span id="loginBtnText"><i class="fa-solid fa-right-to-bracket me-2"></i>Sign In</span>
                    <span id="loginBtnSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                </button>
            </form>

            <!-- Recovery Section -->
            <div class="mt-2">
                <button type="button" id="btnOpenRecovery" class="btn btn-outline-warning w-100 py-2 rounded-3 fs-7 fw-600"
                    data-bs-toggle="modal" data-bs-target="#recoveryModal">
                    <i class="fa-solid fa-key me-2"></i>Account Recovery
                </button>
                <p class="text-center mt-2 mb-0" style="font-size:12px; color: rgba(255,255,255,0.5); line-height:1.4;">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    If your email address is registered in our database, you will receive an email with a login link, allowing you to log in directly.
                </p>
            </div>

            <div class="text-center mt-3 pt-3 border-top border-secondary">
                <p class="fs-7 text-white mb-0">Don't have an account yet? <a href="/signup" class="text-info fw-600 text-decoration-none">Sign Up</a></p>
            </div>
        </div>

        <!-- ── Recovery Modal ─────────────────────────────────────── -->
        <div class="modal fade" id="recoveryModal" tabindex="-1" aria-labelledby="recoveryModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="background: #1a1f2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px;">
                    <div class="modal-header border-bottom border-secondary px-4 py-3">
                        <h5 class="modal-title text-white fw-700" id="recoveryModalLabel">
                            <i class="fa-solid fa-key text-warning me-2"></i>Account Recovery
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body px-4 py-4">
                        <p class="text-white-50 fs-7 mb-3">
                            Enter your 12-word recovery phrase to receive a login link at your registered email address.
                        </p>
                        <div class="mb-3">
                            <label for="recoveryPhraseInput" class="form-label text-light fs-7 fw-600">
                                12-Word Recovery Phrase
                            </label>
                            <textarea
                                id="recoveryPhraseInput"
                                class="form-control font-mono"
                                rows="3"
                                placeholder="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
                                autocomplete="off"
                                spellcheck="false"
                                style="background:#0d1117; color:#e6edf3; border:1px solid rgba(255,255,255,0.15); border-radius:10px; resize:none; font-size:13px; letter-spacing:0.3px;"
                            ></textarea>
                            <div class="mt-1">
                                <small id="recoveryWordCount" class="text-muted fs-8">0 / 12 words</small>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary px-4 py-3">
                        <button type="button" class="btn btn-secondary rounded-3 fs-7" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" id="btnRecoverySubmit" class="btn btn-warning rounded-3 fs-7 fw-600 px-4">
                            <span id="recoveryBtnText"><i class="fa-solid fa-unlock me-2"></i>Recovery Now</span>
                            <span id="recoveryBtnSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/js/common.js"></script>

        <% if (typeof footer !== 'undefined' && footer?.js?.length > 0) { %>
            <% footer.js.forEach(file => { %>
                <script src="/js/<%= file %>"></script>
            <% }); %>
        <% } %>
    </body>
</html>